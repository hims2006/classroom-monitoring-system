DATABASE_URL=mysql+pymysql://root:password@localhost:3306/classroom_monitoring
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=classroom_monitoring

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

APP_NAME=AI Classroom Monitoring System
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,localhost:3000

CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

MAX_UPLOAD_SIZE_MB=100
UPLOAD_FOLDER=./uploads

AI_MODEL_PHONE=yolov8n.pt
AI_CONFIDENCE_THRESHOLD=0.45
AI_MAX_FACES=10
AI_FRAME_RATE=30

WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_TIMEOUT=300

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
